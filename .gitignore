# Závislosti a build
node_modules/
.next/
*.tsbuildinfo

# Stiahnuté podklady zo štatistického úradu (7,6 MB).
# Do repozitára nepatria — kedykoľvek sa stiahnu znovu príkazom
# `npm run stiahni`. Verzuje sa len index s hashmi, ktorý dokladá,
# ktorý súbor sme mali a v akej podobe.
portal/data-raw/*
!portal/data-raw/index.json

# Dátová vrstva portálu — generuje ju `npm run data` z registra
# a stiahnutých tabuliek. Odvodené dáta sa neverzujú.
portal/src/data/*.json

# Rozbalené kópie zdrojových archívov (originály sú verzované ako .zip)
CSV obci/rozbalene/*
!CSV obci/rozbalene/lookup_sk_obec.csv

# Systémové
.DS_Store
Thumbs.db
